{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "td613.research-intake/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_id",
    "kind",
    "title",
    "recorded_at",
    "author",
    "human_request_ref",
    "visibility",
    "body",
    "sources",
    "evidence"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "td613.research-intake/v1"
      ]
    },
    "record_id": {
      "type": "string",
      "pattern": "^R-[A-Z0-9][A-Z0-9_-]{2,95}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "concept",
        "paper",
        "experiment",
        "theorem",
        "source_note",
        "correction"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "human_request_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200000
    },
    "aliases": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "family": {
      "type": "string",
      "maxLength": 500
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "kind",
          "locator",
          "capture_status"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "github",
              "provider_api",
              "published_paper",
              "operator_paper",
              "artifact",
              "human_observation"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "capture_status": {
            "type": "string",
            "enum": [
              "ORIGINAL_CAPTURE",
              "CITED_ONLY",
              "OPERATOR_SUPPLIED",
              "UNAVAILABLE"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "note": {
            "type": "string",
            "maxLength": 10000
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "earned_claim",
        "claim_ceiling",
        "missing_evidence"
      ],
      "properties": {
        "disposition": {
          "type": "string",
          "enum": [
            "CONCEPTUAL",
            "SPECIFIED",
            "OFFLINE_EXECUTED",
            "CAPTURE_OBSERVED",
            "HELD",
            "FAILED",
            "ADJUDICATION_RECORDED"
          ]
        },
        "earned_claim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "missing_evidence": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "adjudication_ref": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "execution_status"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "execution_status": {
          "type": "string",
          "enum": [
            "NOT_RUN",
            "ATTEMPTED",
            "CAPTURED",
            "FAILED",
            "UNKNOWN"
          ]
        },
        "preregistration_ref": {
          "type": "string",
          "maxLength": 4000
        },
        "provider": {
          "type": "string",
          "maxLength": 500
        },
        "model": {
          "type": "string",
          "maxLength": 500
        },
        "request_ref": {
          "type": "string",
          "maxLength": 4000
        },
        "response_ref": {
          "type": "string",
          "maxLength": 4000
        },
        "control_ref": {
          "type": "string",
          "maxLength": 4000
        },
        "measurement_ref": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "relations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "target"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "cites_record",
              "tests",
              "qualifies",
              "contradicts",
              "extends",
              "defines"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "supersedes": {
      "type": "string",
      "pattern": "^R-[A-Z0-9][A-Z0-9_-]{2,95}$"
    },
    "extensions": {
      "type": "object"
    }
  }
}
